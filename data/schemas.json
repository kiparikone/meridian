{
  "note": "Field-level schemas as defined in Base44 AlphaStrata (app id 69ca87fae153629260c39bb7) at export time, 2026-09-28. Kept for reference so the flat JSON files in this directory are self-describing without needing to re-query Base44. PortfolioPosition is intentionally excluded — it was marked DEPRECATED in Base44 on 2026-08-19 (duplicate of Position) and holds no data worth migrating.",
  "ScoredStock": {
    "required": ["ticker", "framework", "composite_score", "signal"],
    "properties": {
      "ticker": "string", "company_name": "string",
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks"],
      "market_regime": ["Risk-On", "Neutral", "Risk-Off", "Crisis"],
      "composite_score": "number 0-100",
      "rank": "number", "signal": ["Strong Buy", "Buy", "Hold", "Sell", "Strong Sell"],
      "price": "number", "change_pct": "number", "volume": "number",
      "dimension_scores": {"fundamental": "number", "sentiment": "number", "risk": "number", "catalyst": "number", "momentum": "number", "technical": "number"},
      "run_id": "string (ref to ScoringRun.id)", "notes": "string"
    }
  },
  "ScoringRun": {
    "required": ["framework", "run_date", "market_regime", "status"],
    "properties": {
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks"],
      "market_regime": ["Risk-On", "Neutral", "Risk-Off", "Crisis"],
      "run_date": "date", "next_run_date": "date",
      "status": ["Completed", "Overdue", "In Progress"],
      "universe_size": "number", "notes": "string"
    }
  },
  "PredictionLog": {
    "required": ["ticker", "framework", "predicted_signal", "entry_date"],
    "properties": {
      "ticker": "string",
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks", "Macro ETF"],
      "predicted_signal": ["Strong Buy", "Buy", "Hold", "Sell", "Strong Sell"],
      "predicted_composite": "number",
      "direction_predicted": ["Up", "Down"],
      "direction_hit": "boolean — did predicted direction match actual",
      "entry_date": "date", "entry_price": "number", "target_price": "number (90-day)",
      "measurement_date": "date", "current_price": "number",
      "actual_return_pct": "number", "benchmark_return_pct": "number (SPY)",
      "outperformed": "boolean — return-based, independent of direction_hit (see notes on ticker=AI for why these two fields must stay separate)",
      "scored_stock_id": "string (ref)", "notes": "string"
    }
  },
  "Position": {
    "required": ["ticker", "framework", "entry_price", "position_size", "status"],
    "properties": {
      "ticker": "string", "company_name": "string",
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks", "Macro ETF"],
      "entry_date": "date", "entry_price": "number",
      "position_size": "number (shares)", "position_size_pct": "number (% of portfolio)",
      "current_price": "number", "status": ["Open", "Closed", "Stopped Out"],
      "exit_date": "date", "exit_price": "number", "exit_reason": "string",
      "stop_loss": "number", "take_profit": "number",
      "scored_stock_id": "string (ref, blank if not framework-derived)", "notes": "string"
    }
  },
  "FrameworkConfig": {
    "required": ["framework", "market_regime"],
    "properties": {
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks"],
      "market_regime": ["Risk-On", "Neutral", "Risk-Off", "Crisis"],
      "weight_fundamental": "number 0-100", "weight_technical": "number 0-100",
      "weight_momentum": "number 0-100", "weight_risk": "number 0-100",
      "weight_sentiment": "number 0-100", "weight_catalyst": "number 0-100",
      "description": "string — for AI/Robotics, Energy, Penny Stocks, Pharma/Biotech, the REAL per-dimension weights and methodology context live here as free text, not in the 6 generic weight_* fields above, which don't map cleanly onto each framework's actual named dimensions (see notes in framework_config.json)"
    }
  },
  "BinaryEvent": {
    "required": ["ticker", "event_type", "event_date"],
    "properties": {
      "ticker": "string", "company_name": "string",
      "event_type": ["PDUFA", "Earnings", "FDA Decision", "Clinical Trial", "Conference", "Other"],
      "event_date": "date", "impact": ["High", "Medium", "Low"],
      "framework": ["AI/Robotics", "Penny Stocks", "Pharma/Biotech", "Energy", "General Stocks"],
      "description": "string"
    }
  }
}
